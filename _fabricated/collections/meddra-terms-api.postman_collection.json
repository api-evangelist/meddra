        {
          "id": "9ed9d37a-a7dc-4c84-93f5-d4cc25c67bb7",
          "name": "Get a term by code",
          "request": {
            "name": "Get a term by code",
            "description": {
              "content": "Retrieve a specific MedDRA term by its numeric code, returning the term name, level, current status, and parent/child hierarchy links.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "terms",
                ":termCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "en"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "termCode",
                  "description": "(Required) MedDRA term code (e.g., 10019211 for HLT \"Hepatic failures\")"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
